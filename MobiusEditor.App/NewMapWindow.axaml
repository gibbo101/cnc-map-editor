<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MobiusEditor.App.NewMapWindow"
        WindowStartupLocation="CenterOwner"
        Title="New map" Width="340" SizeToContent="Height">
  <DockPanel Margin="6">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,6,0,0">
      <Button Name="OkButton" Content="Create" MinWidth="80" />
      <Button Name="CancelButton" Content="Cancel" MinWidth="80" />
    </StackPanel>
    <StackPanel Spacing="6">
      <TextBlock Text="Theater" FontWeight="Bold" />
      <ListBox Name="TheaterList" Height="150" />
      <TextBlock Text="Playable size (cells)" FontWeight="Bold" />
      <ComboBox Name="SizePreset" HorizontalAlignment="Stretch" />
      <Grid ColumnDefinitions="*,12,*">
        <NumericUpDown Grid.Column="0" Name="WidthNud" FormatString="0" Minimum="16" />
        <NumericUpDown Grid.Column="2" Name="HeightNud" FormatString="0" Minimum="16" />
      </Grid>
      <CheckBox Name="RandomFill" Content="Random skirmish fill" />
      <StackPanel Name="RandomPanel" Spacing="4" IsVisible="False" Margin="12,0,0,0">
        <Grid ColumnDefinitions="70,*">
          <TextBlock Grid.Column="0" Text="Style" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" Name="WaterStyleCombo" HorizontalAlignment="Stretch" />
        </Grid>
        <Grid ColumnDefinitions="70,*,12,60,*">
          <TextBlock Grid.Column="0" Text="Seed" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Name="SeedNud" FormatString="0" Minimum="0" Maximum="2147483647" Value="1" />
          <TextBlock Grid.Column="3" Text="Players" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="4" Name="PlayersNud" FormatString="0" Minimum="2" Maximum="8" Value="4" />
        </Grid>
        <Grid ColumnDefinitions="70,*">
          <TextBlock Grid.Column="0" Text="Trees" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Name="TreesSlider" Minimum="0" Maximum="1" Value="0.5" />
        </Grid>
        <Grid ColumnDefinitions="70,*">
          <TextBlock Grid.Column="0" Text="Resources" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Name="OreSlider" Minimum="0" Maximum="1" Value="0.5" />
        </Grid>
        <Grid ColumnDefinitions="70,*">
          <TextBlock Grid.Column="0" Text="Water" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Name="WaterSlider" Minimum="0" Maximum="1" Value="0.5" />
        </Grid>
        <Grid ColumnDefinitions="70,*,12,*">
          <TextBlock Grid.Column="0" Text="Villages" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Name="VillagesNud" FormatString="0" Minimum="0" Maximum="8" Value="2" />
          <CheckBox Grid.Column="3" Name="RoadsCheck" Content="Roads" IsChecked="True" />
        </Grid>
      </StackPanel>
      <TextBlock Name="EmptyMapHint" Text="A new map starts empty; place two player-start waypoints before saving a skirmish map." TextWrapping="Wrap" Opacity="0.8" />
      <StackPanel Name="CreateProgress" Spacing="4" IsVisible="False">
        <ProgressBar IsIndeterminate="True" />
        <TextBlock Name="CreateProgressLabel" HorizontalAlignment="Center" Opacity="0.9" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
