<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="using:MobiusEditor.Model"
        xmlns:app="using:MobiusEditor.App"
        x:Class="MobiusEditor.App.MainWindow"
        Title="C&amp;C Map Editor" Width="1280" Height="800">
  <Window.DataTemplates>
    <DataTemplate x:DataType="app:PaletteEntry">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Border Width="40" Height="40" Background="#20808080">
          <Image Source="{Binding Image}" Stretch="Uniform" />
        </Border>
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:DataType="app:PaletteHeader">
      <TextBlock Text="{Binding Label}" FontWeight="Bold" Opacity="0.7" Margin="0,6,0,2" />
    </DataTemplate>
  </Window.DataTemplates>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6">
      <Button Name="NewButton" Content="New…" IsEnabled="False" />
      <Button Name="OpenButton" Content="Open…" />
      <Button Name="SaveAsButton" Content="Save as…" IsEnabled="False" />
      <Separator Width="12" />
      <Button Name="ZoomOutButton" Content="−" IsEnabled="False" />
      <TextBlock Name="ZoomLabel" VerticalAlignment="Center" Text="25%" />
      <Button Name="ZoomInButton" Content="+" IsEnabled="False" />
      <Separator Width="12" />
      <Button Name="UndoButton" Content="Undo" IsEnabled="False" />
      <Button Name="RedoButton" Content="Redo" IsEnabled="False" />
      <Separator Width="12" />
      <Button Name="SettingsButton" Content="Settings…" IsEnabled="False" />
      <Button Name="TriggersButton" Content="Triggers…" IsEnabled="False" />
      <Button Name="TeamsButton" Content="Teams…" IsEnabled="False" />
      <Separator Width="12" />
      <TextBlock VerticalAlignment="Center" Text="House:" />
      <ComboBox Name="HouseCombo" MinWidth="110" IsEnabled="False" />
      <Separator Width="12" />
      <ToggleButton Name="EraserButton" Content="Eraser" IsEnabled="False" />
      <Separator Width="12" />
      <TextBlock Name="TitleLabel" VerticalAlignment="Center" Text="No map" FontWeight="Bold" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Name="StatusLabel" Margin="6,3" Text="Open a map to begin." />
    <Grid ColumnDefinitions="220,4,*,4,230">
    <TabControl Grid.Column="0" Name="ToolTabs">
      <TabItem Header="Tiles">
        <ListBox Name="TemplatePalette" />
      </TabItem>
      <TabItem Header="Terrain">
        <ListBox Name="TerrainPalette" />
      </TabItem>
      <TabItem Header="Overlay">
        <ListBox Name="OverlayPalette" />
      </TabItem>
      <TabItem Header="Buildings">
        <ListBox Name="BuildingPalette" />
      </TabItem>
      <TabItem Header="Units">
        <ListBox Name="UnitPalette" />
      </TabItem>
      <TabItem Header="Infantry">
        <ListBox Name="InfantryPalette" />
      </TabItem>
      <TabItem Header="Smudge">
        <ListBox Name="SmudgePalette" />
      </TabItem>
      <TabItem Header="Cell trig.">
        <ListBox Name="CellTriggerPalette" />
      </TabItem>
      <TabItem Header="Waypoints">
        <ListBox Name="WaypointPalette" />
      </TabItem>
    </TabControl>
    <GridSplitter Grid.Column="1" Background="#30808080" />
    <GridSplitter Grid.Column="3" Background="#30808080" />
    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
      <StackPanel Name="PropertiesPanel" IsVisible="False" Spacing="6" Margin="6">
        <TextBlock Name="PropTitle" FontWeight="Bold" />
        <TextBlock Text="House" />
        <ComboBox Name="PropHouse" HorizontalAlignment="Stretch" />
        <TextBlock Text="Strength" />
        <NumericUpDown Name="PropStrength" Minimum="1" Maximum="256" FormatString="0" />
        <StackPanel Name="PropDirectionRow" Spacing="6">
          <TextBlock Text="Direction" />
          <ComboBox Name="PropDirection" HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel Name="PropMissionRow" Spacing="6">
          <TextBlock Text="Order" />
          <ComboBox Name="PropMission" HorizontalAlignment="Stretch" />
        </StackPanel>
        <TextBlock Text="Trigger" />
        <ComboBox Name="PropTrigger" HorizontalAlignment="Stretch" />
        <StackPanel Name="PropBuildingRow" Spacing="6">
          <TextBlock Text="Base priority" />
          <NumericUpDown Name="PropBasePriority" Minimum="-1" Maximum="2147483647" FormatString="0" />
          <CheckBox Name="PropPrebuilt" Content="Prebuilt" />
          <CheckBox Name="PropSellable" Content="Sellable" />
          <CheckBox Name="PropRebuild" Content="Rebuild" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Panel Grid.Column="2">
      <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#202020">
        <Panel Name="MapPanel" Background="#202020" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Image Name="MapImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
          <Border Name="BoundsBorder" IsHitTestVisible="False" IsVisible="False"
                  BorderBrush="#B000E5FF" BorderThickness="2"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
          <Border Name="GhostBorder" IsHitTestVisible="False" IsVisible="False"
                  BorderBrush="#DDFFDD00" BorderThickness="1" Background="#18FFDD00"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
            <Image Name="GhostImage" Opacity="0.6" Stretch="Fill" />
          </Border>
        </Panel>
      </ScrollViewer>
      <Border Name="BusyOverlay" IsVisible="False" Background="#60000000">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <ProgressBar IsIndeterminate="True" Width="240" />
          <TextBlock Name="BusyLabel" Foreground="White" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Panel>
    </Grid>
  </DockPanel>
</Window>
